-- allium: 3
-- fts.allium
--
-- Full-text search over a table's documents, answered at any valid time and system time.
--
-- The unit indexed is the event, one row of a trie data file, never the resolved entity.
-- Each trie file of an indexed table may carry one search file per index definition: an inverted index over that file's rows, built from it and deleted with it.
-- A search file only nominates candidates.
-- Which version of an entity is visible at the query's valid and system time is decided by the scan's bitemporal resolution, as it is for every other predicate, and MATCH is re-checked on the resolved row.
-- So a search file that is missing costs a query time and never changes its result.
--
-- The core knows a search file only as an artefact of kind `search`: trie-cat.allium records artefacts on a trie's entry, db.allium carries ArtefactsAdded through the leader, and gc.allium deletes a garbage trie's artefacts with it.
-- This spec owns what an artefact of kind `search` holds, which definitions and jobs produce them, and how a query reads them.
--
-- See: rust/crates/search, rust/crates/text, rust/crates/maintenance/src/artefact.rs, rust/crates/query/src/accelerate.rs; plan: fts-implementation.adoc

use "./trie-cat.allium" as trie_cat
use "./db.allium" as db

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    database: db/Database
    trie_catalog: trie_cat/TrieCatalog
    search_definitions: SearchDefinitions
}

------------------------------------------------------------
-- Values
------------------------------------------------------------

value SearchIndexDefinition {
    -- A document of `xt.search_indexes`, keyed by the index's name.
    name: String
    table: trie_cat/TableRef
    -- Only the UTF-8 leg of each named column is indexed; other legs of the same column contribute no terms.
    columns: List<String>
    analyzer: String
    -- The defining transaction's id, so redefining an index under its name is a new version.
    version: Integer

    -- Derived
    -- The artefact definition id names the analyzer and search file format versions, so a change to either builds new search files rather than reading old ones.
    artefact_id: "{name}~a{analyzer_version}f{format_version}"
}

value SearchDoc {
    -- One document per row of the trie's data file, put, delete and erase alike; a delete or erase contributes no terms.
    doc_id: Integer      -- the row's ordinal in the data file
    iid: Bytes
    system_from: Instant
    valid_from: Instant
    valid_to: Instant
    -- The row's `_recency` where the data file carries it (compaction.allium: HistoricalRowsCarryComputedRecency), and ∞ otherwise.
    recency: Instant
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity SearchDefinitions {
    -- The definitions in force: `xt.search_indexes` read at a basis, as of the reader's current time in valid time.
    -- They are documents the indexer writes, so every node reading at the same basis holds the same set.
    -- A node reads them once per committed basis and reuses them across scans and jobs; a snapshot carrying a transaction's own writes reads them afresh.
    definitions: List<SearchIndexDefinition>
}

entity SearchJob {
    -- An artefact job of kind `search`; ephemeral, like compaction.allium's CompactionJob.
    table: trie_cat/TableRef
    trie_key: trie_cat/TrieKey
    definition: SearchIndexDefinition
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- See: server config `search: {enabled, threads}`, NodeOptions.artefact_threads / scan_acceleration.
    -- Off stops the lane and the accelerator together; MATCH is then answered by scanning.
    enabled: Boolean = true
    threads: Integer = 1
    -- Above this many candidates, the scan runs unnarrowed.
    max_candidates: Integer = 100000
    -- Above this many bytes of selected tries the lane should have indexed but has not, the scan runs unnarrowed rather than reading them twice.
    -- Level 0 and the partial level-1 current trie, which the lane never indexes, do not count.
    max_unindexed_bytes: Integer = 67108864
}

------------------------------------------------------------
-- Rules: Definitions
------------------------------------------------------------

rule DefineSearchIndex {
    -- CREATE SEARCH INDEX name ON table (column, ...) is a transaction; the indexer writes its document at the transaction's system time, valid from then on.
    when: SearchIndexDefined(definition)

    ensures:
        search_definitions.definitions.add(definition)
}

rule DropSearchIndex {
    -- DROP SEARCH INDEX deletes the document; the dropped definition's search files stay on their tries' entries and go with those tries.
    when: SearchIndexDropped(name)

    ensures:
        search_definitions.definitions.remove(name)
}

------------------------------------------------------------
-- Rules: Index lane
------------------------------------------------------------

-- Search jobs are the artefact lane's jobs (maintenance/src/artefact.rs: available_artefact_jobs) for the definitions in force:
-- a live trie above level 0, other than a level-1 current trie below the file size target, lacking an artefact for the definition's artefact id and version.
-- Level 0 and the partial level-1 current trie are rewritten within a block or two, so the scan evaluates MATCH on them directly.
-- Jobs run current side first, then higher levels first.

rule SearchJobRuns {
    -- The job downloads the data file to a temporary file and reads it a page at a time, each page under its memory reservation.
    -- It reserves the segment's indexing heap up front, in proportion to the trie's size, builds the segment on disk, and streams the bundle to the object store.
    -- A job the memory budget cannot admit fails, and is eligible again at the next block.
    when: job: SearchJob.created

    ensures:
        BuildAndUploadSearchFile(job)
        db/ArtefactsAdded(table: job.table, trie_key: job.trie_key, record: search_record(job)) appended to database.source_log
}

rule RepairUnreadableSearchFile {
    -- A scan that cannot read a recorded search file evaluates that trie from its data file and reports the file to its node's lane, which wakes for it.
    -- The lane drops its cached copies and reads the object afresh; if it is still unreadable, it deletes the object and builds it again.
    -- Search files are deterministic, so the rebuilt object has the bytes the record was made for, and the record stands.
    -- A report whose trie is no longer live, or whose definition is no longer in force, is dropped.
    when: SearchFileUnreadable(table, trie_key, definition)

    ensures:
        SearchJob.created(table: table, trie_key: trie_key, definition: definition)
}

------------------------------------------------------------
-- Rules: Query
------------------------------------------------------------

-- MATCH(column, query) holds when the column's UTF-8 value holds every term of the query, tokenised by the analyzer.
-- SEARCH_SCORE(column, query) is the BM25 of that value for the query's terms.
--
-- A scan with a MATCH conjunct on a column that a definition in force covers is narrowed before it opens:
--
--   1. The scan selects tries exactly as it does without MATCH.
--   2. A selected trie whose entry records a search file for that definition contributes the IIDs of its docs whose terms satisfy the query.
--      A doc whose own valid interval misses the query's, whose system-from is at or after the query's system upper bound, or whose recency is at or before the earlier of the query's valid and system lower bounds, contributes nothing.
--   3. A selected trie with no such record, or whose file cannot be read, contributes the IIDs of its matching rows, read from its data file, under the same rule.
--   4. Every live segment contributes the IIDs of its matching rows under the same rule, with recency ∞.
--   5. The scan runs restricted to the union, resolving each candidate's full history in every selected trie and live segment.
--   6. MATCH is evaluated on each resolved row.
--
-- Past max_candidates candidates, or max_unindexed_bytes of tries without a search file, the scan runs unnarrowed instead.
--
-- Each current-side search file the narrowing opens is registered with the query as a corpus source, once however often the scan reopens.
-- SEARCH_SCORE sums documents, tokens and each of its terms' document frequencies over every source the query registered; with none, each term's inverse document frequency is 1.

rule MatchIsAResidualPredicate {
    when: ScanWithMatch(scan, predicate)

    let candidates = search_candidates(scan, predicate)

    ensures:
        ScanRestrictedToIids(scan, candidates)
        FilterResolvedRows(scan, predicate)
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract SearchFileLayout {
    -- What a search file holds.
    -- See: search/src/file.rs

    @invariant PureFunctionOfFileAndDefinition
        -- A search file's bytes are a deterministic function of its trie's data file, its definition and the job's identity.
        -- Every node that runs the same job writes the same object.

    @invariant OneDocPerRow
        -- A search file has one document per row of its trie's data file, and a document's id is that row's ordinal.

    @invariant DocColumnsAreTheRowsOwn
        -- A document's iid, system_from, valid_from, valid_to and recency are those its row was written with, unaffected by any later event.

    @invariant TokensAreTheResidualsTokens
        -- A search file's terms are the analyzer's tokens of each row's UTF-8 value, the same tokens MATCH evaluates on a resolved row.
}

contract SearchCorrectness {
    -- What narrowing may and may not change about a query.

    @invariant ResultIndependentOfSearchFiles
        -- A query's rows are the same whichever search files exist, are readable, or are missing, including none.
        -- SEARCH_SCORE's values are not rows: they depend on the search files a query read (ScoresApproximate).

    @invariant CandidatesAreASuperset
        -- Every IID with a visible row satisfying MATCH at the query's valid and system time is in the candidate set.

    @invariant VisibilityIsResolved
        -- Whether a row is visible is decided by the scan's resolution over the candidate's full history.
        -- A document's own columns only ever rule a candidate out: resolution narrows an event's interval and never widens it.

    @invariant SearchFilesFromTheSnapshot
        -- A scan reads the search files its snapshot's catalog records, and no others.
        -- A node keeps opened files across queries by object key, which names immutable bytes, so a kept file is never stale.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface FullTextSearch {
    facing client: db/Client

    context db: db/Database

    provides:
        SearchIndexDefined(definition)
        SearchIndexDropped(name)
        ScanWithMatch(scan, predicate)

    contracts:
        demands SearchCorrectness

    @guarantee MatchAtAnyTime
        -- MATCH answers at any valid time and system time the scan accepts, the default as-of-now included.

    @guarantee ScoresApproximate
        -- Scores rank results within one query.
        -- They are summed over the search files the query read, across every column and table it narrowed, so they move as compaction and the lane change those files, and with no files each term's inverse document frequency is 1.
}

-- Black box helpers used in rule expressions:
--   search_record(job)                  — the artefact record of a built search file: kind `search`, the definition's artefact id and version
--   search_candidates(scan, predicate)  — steps 1–4 of the query plan
--   BuildAndUploadSearchFile(job)       — tokenise the data file's rows and upload the bundled index under the trie's artefact key

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "A node that uploads a search file and fails before appending ArtefactsAdded leaves a file no record names until its trie is collected. Is that bounded enough, or does the lane sweep its own unrecorded keys?"

open question "Ranking verifies candidates by resolving them all; does a block-max WAND top-k, verifying candidates in batches, earn its complexity?"

open question "Do definitions record positions? Phrase queries need them, at roughly double the search file size."

open question "Is the historical side indexed by default, or only on request? As-of-now queries read the current side and recent historical partitions only."

open question "How does fan-out scale? Every current-side search file is a candidate for every query, one per ~100MB trie; term blooms on the artefact record, and search files spanning a completed partition group, are the levers."

open question "NOT MATCH, and count(*) over MATCH, gain little from narrowing: the first has no candidate superset, the second must resolve every candidate. Both are answered by scanning today."

open question "Do live segments keep in-memory postings, rather than being tokenised by every query that narrows a scan?"
