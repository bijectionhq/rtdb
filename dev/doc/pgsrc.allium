-- allium: 3
-- pgsrc.allium
--
-- Scope: PostgreSQL source confirmation and native mirror ingestion.
-- The confirmation rules track received and recoverable positions, redelivery, failed imports, and stream reopening.
-- XTDB's processing model is specified in db.allium.
-- Type mappings, TOAST and replica-identity constraints, and slot and publication creation are outside this scope.
--
-- db.allium describes when XTDB can recover an external-source token.
-- This spec describes how a recoverable token bounds PostgreSQL confirmation.

---- Given

given {
    source: PgSource
    xtdb: XtdbTarget
}

---- External Entities

external entity XtdbTarget {
    -- A completed import token from an adopted checkpoint.
    durable_lsn: Integer?
    -- A completed import token covered by the retained durable journal and its storage.
    replay_lsn: Integer?
}

external entity PgSlot {
    confirmed_lsn: Integer
}

---- Contracts

contract UpstreamWalSemantics {
    -- What Postgres owes us.

    deliver: (lsn: Integer) -> Boolean
    keepalive: () -> Integer

    @invariant RetainsEverythingAboveConfirmed
        -- WAL above confirmed_lsn remains readable, and WAL below it may be
        -- discarded at any moment.
        -- - Retention is per-server, not per-publication: our slot holds every
        --   database's WAL above our confirmed position.

    @invariant ResendsFromConfirmed
        -- On reconnection, delivery resumes from confirmed_lsn.
        -- - So a torn-down stream costs a re-read, never a gap.
        -- - And confirmed_lsn can lag a position we already imported, which is
        --   what the re-delivery skip exists for.

    @invariant IgnoresRetrogradeConfirmations
        -- A confirmation below confirmed_lsn has no effect.
        -- - So the confirmed position is monotonic whether or not we track it.

    @invariant ReceivedTrailsUndeliveredCommits
        -- The received position never reaches the commit LSN of a transaction whose
        -- commit the upstream has not delivered.
        -- - So nothing at or below it awaits delivery, whether it last advanced on
        --   a keepalive or part-way through a transaction still in flight.
        -- - The received branch of confirmable_lsn rests on this and on nothing
        --   else about the upstream's position.
        -- - Postgres additionally pins restart_lsn at the start of an in-progress
        --   transaction, so one is always re-sent in full.

    @invariant CopiesOnlyAdvancingSlots
        -- A slot is copied to a standby only while its position advances.
        -- - So upstream failover depends on our flush cadence.
}

contract TargetDurability {
    -- What the target owes us: the meaning of durable_lsn.

    submit: (lsn: Integer) -> Boolean
    durable_position: () -> Integer

    @invariant DurableIsRecoverableUnaided
        -- Everything at or below durable_lsn is recoverable from the target's
        -- storage alone, without the upstream.

    @invariant DurableCoversOnlySubmitted
        -- durable_lsn never names a position we did not submit.
        -- - Violation means the two describe different slots, or a token
        --   survived a re-snapshot it should not have.

    @invariant DurableIsMonotonic
        -- durable_lsn never retreats.
        -- - A retreat would make an already-confirmed position unrecoverable.

    @invariant ReplayExtentRecoversUnaided
        -- The target can reopen the same storage and replay its durable journal through replay_lsn.
        -- The journal retains the required prefix through process restart.
}

contract ConfirmablePosition {
    -- What we owe the upstream.

    confirm: (lsn: Integer) -> Boolean

    @invariant ConfirmedIsRecoverable
        -- Every confirmed position is one the target can recover to unaided.
        -- - After losing everything but storage, resuming there loses nothing.

    @invariant SoleConfirmer
        -- At most one party confirms a given slot.
        -- - Two would race to a position neither could justify, each knowing
        --   only its own durable extent.
        -- - A driver that advances the flush position on a schedule of its own is such a party, and knows no durable extent at all.
}

---- Entities and Variants

entity PgSource {
    slot: PgSlot

    -- Recovered, not chosen. Deliberately unordered against durable_lsn: it can
    -- lead, being recovered from state a storage-only recovery would lose.
    start_lsn: Integer

    -- The furthest position the target holds, whether or not its storage has it.
    -- Opens at start_lsn rather than at nothing, because recovery has already put
    -- the target past it — see SourceOpensStream.
    held_lsn: Integer

    -- Advances on every record the upstream sends, so it can sit above the last
    -- commit and below the commit of a transaction still arriving.
    received_lsn: Integer

    -- Losses of the upstream since it last delivered a transaction or went quiet.
    reopen_attempts: Integer

    -- When the next reopen is due; null while none is pending.
    reopen_at: Timestamp?

    last_reopened_at: Timestamp?

    -- Everything the target holds is on the far side of an existing recovery point.
    all_held_durable: xtdb.durable_lsn != null and held_lsn <= xtdb.durable_lsn

    protected_lsn: max(xtdb.durable_lsn ?? 0, xtdb.replay_lsn ?? 0)
    confirmable_lsn: if all_held_durable: received_lsn else: protected_lsn

    has_unconfirmed: confirmable_lsn > slot.confirmed_lsn

    invariant ConfirmedWithinReceived {
        slot.confirmed_lsn <= received_lsn
    }

    invariant ConfirmedWithinDurableWhenBehind {
        not all_held_durable implies slot.confirmed_lsn <= protected_lsn
    }

    invariant HeldWithinReceived {
        held_lsn <= received_lsn
    }

    invariant StartWithinHeld {
        -- The held position includes the progress established during recovery.
        start_lsn <= held_lsn
    }
}

---- Config

config {
    reopen_initial_delay: Duration
    reopen_max_delay: Duration
    reopen_reset_after: Duration
}

---- Rules

rule SourceOpensStream {
    -- The resume position comes from the target, not from the slot. The two are
    -- recovered from different places and the slot's is normally the lower, so
    -- nothing here licenses an inference about slot.confirmed_lsn.
    when: StreamOpened(upstream, source, resume_lsn)

    ensures:
        source.start_lsn = resume_lsn

        -- Not nothing-held: the transactions between the durable extent and
        -- resume_lsn exist only inside the target, so confirming over them would
        -- discard the upstream's copy of the only WAL a storage-only recovery
        -- would need.
        source.held_lsn = resume_lsn

        source.received_lsn = resume_lsn
}

rule SourceReceivesTransaction {
    when: PgTransactionReceived(upstream, source, tx_lsn)

    ensures:
        source.received_lsn = tx_lsn
        source.reopen_attempts = 0

        -- Skipped below start_lsn: per ResendsFromConfirmed the upstream may
        -- re-send what we already hold, and re-importing would record a second
        -- version of it.
        if tx_lsn > source.start_lsn:
            SubmitToTarget(source, tx_lsn)
            source.held_lsn = tx_lsn
}

rule SourceReceivesKeepalive {
    -- A transaction whose changes are all to tables the source ignores arrives as one.
    -- Its WAL holds nothing of ours, so it advances received_lsn as a keepalive does.
    when: PgKeepaliveReceived(upstream, source, upstream_lsn)
    requires: upstream_lsn > source.received_lsn

    ensures:
        source.received_lsn = upstream_lsn
}

rule SourceConfirmsPosition {
    -- A flush, recoverable applied progress or an upstream position report can advance confirmation.
    when: source: PgSource.has_unconfirmed
    requires: source.confirmable_lsn > source.slot.confirmed_lsn

    ensures:
        source.slot.confirmed_lsn = source.confirmable_lsn

    @guidance
        -- A tracked lower bound on slot.confirmed_lsn is enough to skip a
        -- confirmation that would change nothing, and per
        -- IgnoresRetrogradeConfirmations a bound that is too low costs only the
        -- redundant call. It MUST NOT be seeded from start_lsn, which is normally
        -- the higher of the two.
}

rule ImportFailureTearsDownStream {
    -- Not confirmed, and not skipped: leaving the slot put makes the upstream
    -- re-send, per ResendsFromConfirmed.
    when: TargetImportFailed(target, source, error)

    ensures:
        StreamTornDown(source)
}

rule UpstreamLossReopensStream {
    when: UpstreamStreamLost(upstream, source, error)

    let attempt = source.reopen_attempts + 1

    ensures:
        StreamTornDown(source)
        source.reopen_attempts = attempt
        source.reopen_at = now + reopen_delay(attempt, config.reopen_initial_delay, config.reopen_max_delay)

    @guidance
        -- reopen_delay grows exponentially with the attempt, up to reopen_max_delay, and is jittered.
}

rule SourceReopensStream {
    when: source: PgSource.reopen_at <= now
    requires: source.reopen_at != null

    ensures:
        source.reopen_at = null
        source.last_reopened_at = now
        StreamReopenRequested(source)
}

rule QuietUpstreamResetsReopenAttempts {
    when: source: PgSource.last_reopened_at + config.reopen_reset_after <= now
    requires: source.reopen_attempts > 0

    ensures:
        source.reopen_attempts = 0

    @guidance
        -- reopen_reset_after of about 10 minutes.
}

---- Invariants

invariant DurableExtentIsWithinHeld {
    for s in PgSources:
        s.xtdb.durable_lsn != null implies s.xtdb.durable_lsn <= s.held_lsn
}

---- Actor Declarations

actor Upstream {
    identified_by: PgSlot where true
}

actor Target {
    identified_by: XtdbTarget where true
}

---- Surfaces

surface UpstreamReplication {
    facing upstream: Upstream

    context source: PgSource

    provides:
        StreamOpened(upstream, source, resume_lsn)
        PgTransactionReceived(upstream, source, tx_lsn)
        PgKeepaliveReceived(upstream, source, upstream_lsn)
        UpstreamStreamLost(upstream, source, error)

    contracts:
        demands UpstreamWalSemantics
        fulfils ConfirmablePosition

    @guarantee ConfirmationFollowsRecoverableExtent
        -- Flushes and applied replay evidence can advance confirmation.
        -- The feedback writer takes a permit derived by the confirmation state from the recoverable extent and its previously confirmed position.
        -- Hosted feedback waits for the exact adopted checkpoint root and boundary to be installed by the directory or ordered journal recovery authority.

    @guarantee QuietPublicationDoesNotPinUnrelatedWal
        -- When an adopted checkpoint covers held progress, a quiet source confirms received WAL across gaps in its publication.

    @guarantee SlotAdvancesBeforeFirstBlock
        -- An applied token covered by a retained durable journal can advance the slot before the first block.

    @guarantee NoGapOnFailure
        -- No failure path advances the confirmed position past a transaction the
        -- target did not import.

    @guarantee ReopenResumes
        -- A reopened stream opens at the target's recovered position, through SourceOpensStream, on the slot it lost.
        -- - A missing slot therefore holds the source at the reopen until an operator steps in.

    @guarantee ReopensOnlyWhileAssigned
        -- A source whose leader term has ended does not reopen its stream.
        -- - Otherwise a demoted leader would confirm alongside its successor, against SoleConfirmer.
}

surface TargetIngestion {
    facing target: Target

    context source: PgSource

    provides:
        TargetImportFailed(target, source, error)

    contracts:
        demands TargetDurability

    @guarantee NativeMirrorPayloads
        -- The native mirror builds Arrow batches for snapshot and WAL fields in their received order.
        -- Bytea, UUID, date, timestamp, interval, and decimal text feeds typed Arrow columns.
        -- Observed decimal scales, time zones, and interval representations determine the field or dense union legs.
        -- One-dimensional float4 and float8 arrays with default bounds use their corresponding Arrow float children and retain component nulls.
        -- Multidimensional arrays and explicitly bounded arrays retain their PostgreSQL text.
        -- The pgvector vector and halfvec types use Float32 children, with fixed-size lists for declared dimensions and variable-size lists for unconstrained dimensions.
        -- Snapshot type metadata and WAL relation and type messages identify pgvector fields.
        -- Domains over float arrays or pgvector use the Arrow layout of their PostgreSQL base type.
        -- The upstream type catalog supplies the effective dimension for pgvector domains in logical replication.
        -- Ordinary homogeneous floating-point arrays in JSON and JSONB build packed Float64 children.
        -- The JSON decoder borrows scalar tokens during nested document traversal and preserves their spelling for native type inference.
        -- It stages Arrow document vectors with separately resolved event headers.
        -- A complete WAL transaction carries Arrow batches grouped by relation, operation kind and compatible field layout.
        -- The mirror stages rows in upstream event order using Arrow document vectors and typed ID and valid-time columns.
        -- Snapshot fetch uses binary PostgreSQL fields wherever their binary readers preserve the source projection.
        -- Direct binary snapshot readers reserve Arrow column capacity before allocating the column.
        -- Fixed-layout range and opaque Transit columns use Arrow timestamp and binary children.
        -- Array fields use typed Arrow children where the source projection has a list layout.
        -- Document-shaped values retain their observed field and type order.

    @guarantee SubmissionIsOrdered
        -- Transactions are submitted in lsn order, so submitted_lsn is a
        -- watermark rather than a maximum.
}

---- Open Questions

open question "Is ReceivedTrailsUndeliveredCommits true on the server side — can a keepalive carry a position ahead of a commit still being decoded for our publication? The client half holds: pgjdbc sets the receive position from each record's own header, which for a transaction in flight is below its commit. If the server half fails, the received branch of confirmable_lsn is unsafe; if Postgres instead recycles unrelated WAL unasked, the branch is unnecessary and confirmable_lsn collapses to the durable extent."

open question "Which upstream errors, if any, should end the source rather than reopen it? Every loss reopens until real deployments show which errors recur (#5878)."

open question "Which upstream TLS trust and identity checks belong to the PostgreSQL remote configuration?"
    -- The native source verifies the server certificate and hostname whenever TLS is negotiated.
    -- The JDBC default may accept a certificate without that verification.
    -- The remote credential and trust configuration needs an explicit compatibility contract.
