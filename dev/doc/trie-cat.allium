-- allium: 3
-- trie-cat.allium
--
-- The trie catalog: per-table inventory of immutable trie snapshots.
--
-- Tries are added by block flushes (see db.allium) and compaction (see compaction.allium).
-- Tries are read by the scan operator for query execution.
-- Tries are garbage-collected by gc.allium once superseded by compaction output.
-- The native catalog retains adopted L0 identities and lengths for recovery and ordered-index replay after primary compaction supersedes them.
-- A checkpoint reset installs the selected primary pairs while retaining older L0 source identities for ordered-index replay.
--
-- See: trie/TrieCatalog.kt, log/proto/log.proto (TrieDetails, TrieState)

------------------------------------------------------------
-- Values
------------------------------------------------------------

value TableRef {
    -- See: api/.../table/TableRef.kt
    db_name: String
    schema_name: String
    table_name: String
}

value TrieDetails {
    -- Per-trie metadata written to the log on block flush or compaction.
    -- See: log/proto/log.proto (TrieDetails)
    table: TableRef
    trie_key: TrieKey
    data_file_size: Long
    trie_metadata: TrieMetadata
    trie_state: TrieState
    garbage_as_of: Instant?
    -- Files derived from this trie's data file, or from its partition group's data files, at most one per (kind, definition id, definition version).
    -- Empty for a trie no artefact lane has reached.
    artefacts: List<ArtefactRecord>
}

value ArtefactRecord {
    -- One file derived from a trie's data file, or from its partition group's, such as a search file (fts.allium).
    -- See: log/proto/log.proto (ArtefactRecord), index/src/trie_catalog.rs
    kind: String
    definition_id: String
    definition_version: Integer
    -- Opaque to the catalog: the artefact kind owns its encoding.
    stats: Bytes
    -- A record without one is its trie's.
    scope: ArtefactScope
    -- The ordered member list for an artefact whose owner is a pack.
    pack_members: List<TrieKey>
    -- Published object length. A shared group object is counted once.
    file_size: Long?
    -- Exact provider identity supplied by the write response or verified idempotent publication.
    published_version: PublishedObjectVersion?
}

value PublishedObjectVersion {
    bucket: String
    endpoint: String?
    region: String?
    physical_key: String
    version: String
}

-- trie: derived from its trie's data file alone, and stored under the trie's artefact prefix.
-- part_group: derived from the data files of its trie's partition group and recorded alike on each member.
-- pack is stored under its ordered member list and recorded alike on each member.
enum ArtefactScope { trie | part_group | pack }

value ArtefactPack {
    -- Settled primary tries in IID-prefix order, with one recency and mutually disjoint IID prefixes.
    members: List<TrieKey>
}

value PartGroup {
    -- The branch_factor sibling outputs of tiered compaction at one block (rule InsertTrie_General): the same level, recency and parent part, one per bucket.
    -- Only tiered tries belong to one: current tries at level 2 and up, and historical tries at level 3 and up.
    -- The members become live together and are each superseded on their own, so a group-scoped artefact serves whichever members are live.
    -- See: format/src/keys.rs (PartGroup)
    level: Long
    recency: LocalDate?
    parent_part: Bytes
    block_index: Long

    -- Serialised as the members' key with `g` for `l` and the members' own bucket dropped, e.g. g02-rc-b05 for l02-rc-p0-b05 to l02-rc-p3-b05.
}

value TrieMetadata {
    -- See: log/proto/log.proto (TrieMetadata)
    temporal_metadata: TemporalMetadata
    row_count: Long
    iid_bloom: Bytes
}

value TemporalMetadata {
    -- See: log/proto/log.proto (TemporalMetadata)
    min_valid_from: Instant
    max_valid_from: Instant
    min_valid_to: Instant
    max_valid_to: Instant
    min_system_from: Instant
    max_system_from: Instant
}

value TrieKey {
    level: Long
    recency: LocalDate?  -- null = current (∞); date = historical (week ending Monday 0000Z)
    part: Bytes?         -- present at L2+; IID prefix path segments
    block_index: Long

    -- Derived
    is_current: recency = null

    -- Serialised as a string using lex hex encoding for levels and blocks.
    -- A historical key's date uses a nonnegative ISO proleptic Gregorian year through 999999999, followed by two-digit month and day.
    -- The rendered year has at least four digits and carries no sign.
    -- Parsing accepts one through nine year digits and an optional plus sign, with exactly two month and day digits.
    -- It requires months 1 through 12 and days 1 through 31, then clamps the day to the month's last day.
    -- Partition metadata and scan ceilings convert the date to UTC midnight in signed 64-bit microseconds, rejecting overflow.
    -- Lex hex: first digit is the length of the hex string minus one; remainder is the hex string.
    -- e.g. b134 is block 0x34 (decimal 52).
    -- Examples:
    --   l00-rc-b00         level 0, current, block 0
    --   l01-r20200106-b00  level 1, historical, week ending 2020-01-06
    --   l02-rc-p0-b00      level 2, current, IID partition 0, block 0
    --   l02-rc-p0-b00-e01  the same position planned in naming epoch 1
-- XTDB cannot parse a key with an epoch segment, so a log record naming one is framed for an XTDB node to refuse (db.allium: XtdbRefusesRtdbExtensionRecords).
-- Replica publications of compaction output are admitted only in the current naming epoch.
-- A checkpoint in a different naming epoch installs its persisted trie catalog before replay continues.
-- A removal matches the entire trie key, including the naming epoch, in addition to the garbage state.
-- Native compaction records an exact provider version for each file whose publication supplied one.
-- In an enrolled terminal allocation it records the allocation, physical key and entity tag returned by the acknowledged publication or its confirmed retry.
-- The catalog preserves those versions after the trie becomes garbage and across checkpoint and replica serialization.
    -- Compaction outputs carry the catalog's naming epoch, persisted in each block; a compactor reset starts a new epoch, so no name is published twice.
}

------------------------------------------------------------
-- Trie State Lifecycle
------------------------------------------------------------

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Every trie has a state: nascent -> live -> garbage.
-- See: log/proto/log.proto (TrieState)
--
-- nascent: the trie has been uploaded but its job group is not yet complete.
--   A nascent trie is visible to the compactor (so it doesn't re-do the work)
--   but is not yet used for queries.
--
-- live: the trie is complete and available for query execution.
--   A trie becomes live when the last output of its job group is uploaded.
--   At that point, the input tries of the job transition to garbage.
--
-- garbage: the trie has been fully superseded by compaction output.
--   The garbage collector deletes the data and meta files from the object store,
--   then removes the trie from the catalog.
--   A table retirement (rule RetireTable) also makes every trie of the retired table garbage, with no successor.

enum TrieState { nascent | live | garbage }

-- The LSM tree is split into current (C) and historical (H) sides based on the recency of events.
--
-- Current files have recency = ∞ (events whose valid-time range has not been superseded).
-- Historical files have finite recency, partitioned into weekly buckets rolling over every Monday at 0000Z.
--
-- The split exploits the Lindy effect: recently-written rows are more likely to be superseded quickly.

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    trie_catalog: TrieCatalog
}

------------------------------------------------------------
-- Entity
------------------------------------------------------------

-- Behaviourally-relevant fields only; see TrieCatalog.kt for full interface.

value EntityDirectory {
    -- A sealed table's authenticated logical history and erase frontier.
    root: Bytes
    through_block: Integer
    source_rows: Integer
    has_erases: Boolean
    erase_frontier_digest: Bytes
    allocation: Bytes
    writer_fence: Integer
    -- Set only on a retired root: the system time of the transaction that replaced it.
    superseded_at: Instant?
}

entity TrieCatalog {
    -- See: trie/TrieCatalog.kt, trie_catalog.clj
    --
    -- Per-table catalog, keyed by shard = (level, recency, part).
    -- Each shard holds three ordered lists (by block_index descending): live, nascent, garbage.
    -- Also tracks max_block_index per shard for staleness detection.
    -- Each table also owns an independent logical search manifest of authenticated posting receipts.
    -- Primary trie replacement and search-run replacement advance their respective inventories in the catalog cut.
    -- A checkpoint carries active run receipts and pending retirements with the primary trie inventory.
    -- The search-pending intent records the staging owner during upload.
    -- Ordered abandonment retires an unadopted allocation and its receipt survives checkpoint recovery.
    -- Each table has at most one active entity directory.
    -- An entity-directory record is anchored to the L0 block the receipt covers.
    -- Installing the receipt makes it active and retains the former root with its supersession time for collection on the garbage-as-of horizon.
    -- Retired term directories are recorded in the table block with their supersession time and released on the same horizon.
    -- Primary relocation preserves the table's entity directory and event origins.
    --
    -- addTries(tries, as_of): register new tries, transitioning superseded inputs to garbage.
    -- withPartitions(table, tries, as_of): the partition layout table would have with tries
    --   folded in, leaving the catalog unchanged.
    --   No tries gives the layout as it stands, and as_of dates the supersession the added tries
    --   cause exactly as it does in addTries.
    -- refresh: rebuild the entire catalog from block metadata in the object store.
    --   Used by read-only followers after a new block appears.
    -- deleteTries(tries): remove garbage entries from the catalog after file deletion.
    -- withArtefacts(table, entries): record artefacts on their tries' entries (rule AddArtefact).
    -- withoutArtefacts(table, entries): remove artefact records from their tries' entries (rule RemoveArtefact).
    -- retired_as_of(table): when the table's relation was retired (rule RetireTable), or null.
    -- holds(table, trie_key): whether any shard of the table holds the trie, as live, nascent or garbage.
    -- is_live(table, trie_key): whether the table holds the trie in a live shard list.
    -- artefacts(table, trie_key): the artefact records on the trie's entry.
    -- artefact_prefix(table, trie_key): tables/<slug>/artefacts/<trie_key>, under which every artefact of the trie lives.
    -- artefact_key(table, trie_key, kind, definition_id, definition_version): <prefix>/<kind>/<definition_id>-v<definition_version>.bin.
    --   A function of its arguments alone, so every builder of one job writes to one key.
    -- group_members(table, group): the entries the catalog holds for the group's members, live, nascent or garbage; a member it does not hold is left out.
    -- group_has_obsolete_member(table, trie_key): the trie's partition group has an original member that is garbage or absent from the catalog.
    -- group_artefact_prefix(table, group): tables/<slug>/artefacts/<group>, under which every artefact of the group lives.
    -- recorded_artefact_key(table, trie_key, record): artefact_key under the trie's prefix for a trie-scoped record, and under its group's prefix for a group-scoped one.
    tries: Map<TableRef, Map<Shard, ShardState>>
    entity_directories: Map<TableRef, EntityDirectory>
    retired_entity_directories: Map<TableRef, List<EntityDirectory>>
}

value Shard {
    level: Long
    recency: LocalDate?
    part: List<Long>
}

value ShardState {
    live: List<TrieDetails>       -- ordered by block_index descending
    nascent: List<TrieDetails>    -- ordered by block_index descending
    garbage: List<TrieDetails>    -- ordered by block_index descending
    max_block_index: Long
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    branch_factor: Integer = 4
    file_size_target: Long = 104857600   -- 100 MB
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule TriesAdded {
    -- Called by db.allium (block flush, ProcessTriesAddedMessage) and compaction.allium.
    when: TriesAdded(tries, as_of)

    ensures:
        for trie in tries:
            trie_catalog.applyTrieNotification(trie, as_of)
}

rule ApplyTrieNotification {
    -- Idempotent: stale notifications (already-seen block indices) are skipped.
    -- Messages have a total ordering within their shard, so we only ever prepend.
    -- See: trie_catalog.clj (apply-trie-notification, stale-msg?)
    when: ApplyTrieNotification(trie, as_of)

    let shard = (trie.level, trie.recency, trie.part)
    let shard_state = trie_catalog.tries[trie.table][shard]

    requires: not stale(shard_state, trie.block_index)
    -- stale iff shard_state.max_block_index >= trie.block_index

    ensures: InsertTrie(trie, as_of)
}

------------------------------------------------------------
-- Rules: InsertTrie
--
-- The insertion strategy varies by level and recency.
-- Key concepts:
--   Levelled: the new trie supersedes partial (< file_size_target) predecessors
--     in the same shard. Used for L1C, L2H.
--   Tiered: the new trie is added alongside existing tries without superseding.
--     Used for L1H, L2+C, L3+H.
--   Nascent: the trie is not yet queryable; it becomes live when a completion
--     condition is met (L1C arrives for L1H; all partition siblings arrive for L2+).
--
-- See: trie_catalog.clj (insert-trie)
------------------------------------------------------------

rule InsertTrie_L0 {
    -- L0 files are always live immediately.
    when: InsertTrie(trie, as_of)
    requires: trie.level = 0

    ensures:
        add trie as :live to shard [0, trie.recency, trie.part]
}

rule InsertTrie_L1H {
    -- L1H waits for an L1C notice of the same block unless a serving L1C
    -- already covers its block when L1H arrives.
    -- See: trie_catalog.clj (insert-trie, level 1 with recency)
    when: InsertTrie(trie, as_of)
    requires: trie.level = 1 and trie.recency != null

    let l1c_shard = trie_catalog.tries[trie.table][(1, null, trie.part)]
    let l1c_latest = l1c_shard.live.first   -- highest block_index

    let state =
        if l1c_latest != null and l1c_latest.block_index >= trie.block_index:
            :live    -- L1C already exists that covers this block
        else:
            :nascent -- wait for L1C

    ensures:
        add trie as state to shard [1, trie.recency, trie.part]
        -- The pending index contains the recencies of nascent L1H entries
        -- at the root part. Checkpoint recovery derives it from the loaded catalog.
        if state = :nascent and trie.part = []:
            record l1h_recency(trie.block_index, trie.recency)
}

rule InsertTrie_L1C {
    -- L1C is levelled: supersedes partial (< file_size_target) L1C files.
    -- Also supersedes L0 files and marks pending L1H files as live.
    -- See: trie_catalog.clj (insert-trie, level 1 without recency)
    when: InsertTrie(trie, as_of)
    requires: trie.level = 1 and trie.recency = null

    ensures:
        -- 1. Mark any L1H files for this block_index as live.
        for recency in l1h_recencies(trie.block_index):
            mark_block_index_live(shard [1, recency, []], trie.block_index)

        -- 2. Supersede partial L1C files (levelled insertion).
        supersede_partial([1, null, []], trie, as_of)
        add trie as :live to shard [1, null, []]

        -- 3. Supersede L0 files up to this block_index.
        supersede_by_block_index([0, null, []], trie.block_index, as_of)
}

rule InsertTrie_L2H {
    -- L2H is levelled: supersedes partial L2H files and the L1H inputs.
    -- See: trie_catalog.clj (insert-trie, level 2 with recency)
    when: InsertTrie(trie, as_of)
    requires: trie.level = 2 and trie.recency != null

    ensures:
        -- Supersede partial L2H files (levelled insertion).
        supersede_partial([2, trie.recency, trie.part], trie, as_of)
        add trie as :live to shard [2, trie.recency, trie.part]

        -- Supersede L1H inputs up to this block_index.
        supersede_by_block_index([1, trie.recency, []], trie.block_index, as_of)
}

rule InsertTrie_General {
    -- L2+C, L3+H: tiered with partition-group completion.
    -- The trie starts as nascent. When all siblings in the partition group
    -- (branch_factor siblings sharing the same parent part prefix) are present,
    -- all become live and the prior level is superseded.
    -- See: trie_catalog.clj (insert-trie, default case)
    when: InsertTrie(trie, as_of)
    requires: not (trie.level = 0
                   or (trie.level = 1)
                   or (trie.level = 2 and trie.recency != null))

    ensures:
        add trie as :nascent to shard [trie.level, trie.recency, trie.part]

        if completed_part_group(trie):
            -- All branch_factor siblings exist for this block_index.
            mark_part_group_live(trie)

            -- Supersede prior level: parent shard at (level - 1, recency, pop(part)).
            let parent_part = if trie.part.non_empty: trie.part.pop else: trie.part
            supersede_by_block_index(
                [trie.level - 1, trie.recency, parent_part],
                trie.block_index, as_of
            )
}

------------------------------------------------------------
-- Rules: Supersession helpers
------------------------------------------------------------

rule supersede_partial {
    -- Levelled supersession: mark live tries as garbage if they are partial
    -- (data_file_size < file_size_target) and have block_index <= the new trie's.
    -- See: trie_catalog.clj (supersede-partial-tries)
    when: supersede_partial(shard, new_trie, as_of)

    ensures:
        for live_trie in shard.live
            where live_trie.data_file_size < config.file_size_target
              and live_trie.block_index <= new_trie.block_index:
            transition live_trie to :garbage with garbage_as_of = as_of
}

rule supersede_by_block_index {
    -- Unconditional supersession: mark all live tries as garbage
    -- if their block_index <= the given block_index.
    -- See: trie_catalog.clj (supersede-by-block-idx)
    when: supersede_by_block_index(shard, block_index, as_of)

    ensures:
        for live_trie in shard.live
            where live_trie.block_index <= block_index:
            transition live_trie to :garbage with garbage_as_of = as_of
}

rule completed_part_group {
    -- True when all branch_factor siblings at (level, recency, parent_part ++ [0..3])
    -- hold a nascent or live result of the new trie's exact block_index.
    -- High-water marks belong to stale-notice admission. A later partial group
    -- leaves the parent in service until a complete group can replace it.
    when: completed_part_group(trie) -> Boolean

    let parent_part = trie.part.pop
    ensures:
        for p in 0..(config.branch_factor - 1):
            let sibling_shard = trie_catalog.tries[trie.table][(trie.level, trie.recency, parent_part ++ [p])]
            some sibling in sibling_shard.tries where
                sibling.block_index = trie.block_index
                and (sibling.state = :nascent or sibling.state = :live)
}

rule mark_part_group_live {
    -- Transition all nascent tries at the given block_index across the partition group to live.
    -- See: trie_catalog.clj (mark-part-group-live, mark-block-idx-live)
    when: mark_part_group_live(trie)

    let parent_part = trie.part.pop
    ensures:
        for p in 0..(config.branch_factor - 1):
            let shard = [trie.level, trie.recency, parent_part ++ [p]]
            mark_block_index_live(shard, trie.block_index)
}

rule mark_block_index_live {
    -- Find a nascent trie at the given block_index and transition it to live.
    -- See: trie_catalog.clj (mark-block-idx-live)
    when: mark_block_index_live(shard, block_index)

    let nascent_trie = shard.nascent.find(t => t.block_index = block_index)

    ensures:
        if nascent_trie != null:
            transition nascent_trie from :nascent to :live
}

------------------------------------------------------------
-- Rules: Table retirement
------------------------------------------------------------

rule RetireTable {
    -- Applied on every node from a replicated TablesRetired record (gc.allium: RetireDueTables).
    -- A retired relation's table supersedes its tries with no successor: no compaction output replaces them and no reader selects them again.
    -- A table already retired keeps its first retirement time, so a repeated record changes nothing.
    -- A table the catalog does not yet hold is recorded too, so the tries a later block flush gives it arrive as garbage.
    -- Its active search runs retire with it, for collection to release as it does superseded ones.
    -- The retirement time travels in the table's block file, so a recovered catalog keeps it.
    -- See: index/src/trie_catalog.rs (with_retired_tables)
    when: RetireTable(table, as_of)

    ensures:
        trie_catalog.retired_as_of(table) = trie_catalog.retired_as_of(table) ?? as_of
        for shard_state in trie_catalog.tries[table]:
            for trie in shard_state.live + shard_state.nascent:
                transition trie to :garbage with garbage_as_of = trie_catalog.retired_as_of(table)
}

rule InsertTrie_Retired {
    -- Takes precedence over every InsertTrie rule above: a trie arriving for a retired table, from a late flush or an in-flight compaction job, is garbage on arrival and supersedes nothing.
    when: InsertTrie(trie, as_of)
    requires: trie_catalog.retired_as_of(trie.table) != null

    ensures:
        add trie as :garbage to shard [trie.level, trie.recency, trie.part] with garbage_as_of = trie_catalog.retired_as_of(trie.table)
}

------------------------------------------------------------
-- Rules: Refresh and Delete
------------------------------------------------------------

rule FollowerRefreshes {
    -- Read-only nodes refresh the catalog from the object store
    -- when a BlockUploadedMessage arrives (see db.allium: FollowerHandlesBlockUploaded).
    when: FollowerRefreshRequested(block_index)

    ensures:
        trie_catalog.refresh(block_index)
}

------------------------------------------------------------
-- Rules: Artefacts
------------------------------------------------------------

rule AddArtefact {
    -- A source request to adopt a new logical search allocation requires the allocation's staging intent.
    -- A source request for an active run identity reaches catalog validation after its staging intent has been collected.
    -- Intent admission for a source message has a bounded deadline.
    -- An unresolved storage failure leaves the source position unapplied.
    -- Replica replay applies the previously admitted publication in order.
    -- A logical-search publication can install term-directory evidence together with its change to a definition generation's active runs.
    -- The directory update compares the held root and the identities of the active runs before changing either.
    -- A legacy change to the active runs invalidates the directory for that generation.
    -- A recorded entity history authenticates event headers and their Arrow locations within its primary trie.
    -- A history reader authenticates the selected range before decoding Arrow from its retained bytes.
    -- The history and its optional field witnesses are released with that trie's derived files.
    -- Records an artefact on its trie's entry, on applying an artefacts-added record (db.allium: LeaderAppliesOwnArtefactsAdded, HandleReplicaMessage).
    -- A trie keeps the first record for each (kind, definition id, definition version).
    -- A live trie can replace its group-scoped record with its own after an original member becomes obsolete.
    -- Later group records leave the replacement in place.
    -- A singleton record on a live trie can be replaced by a pack record naming that trie.
    -- A live member of a pack with an obsolete member can receive a replacement singleton.
    -- pack_has_obsolete_member holds when any of the receipt's original members is absent or garbage in the table catalog.
    -- The record is part of the trie's TrieDetails, so the table-block files a block upload writes carry it, and a recovery restores it.
    when: AddArtefact(table, trie_key, record)
    requires: trie_catalog.holds(table, trie_key)

    let existing = trie_catalog.artefacts(table, trie_key).filter(r => r.kind = record.kind and r.definition_id = record.definition_id and r.definition_version = record.definition_version)

    ensures:
        if not existing.any(r => true):
            trie_catalog.artefacts(table, trie_key) = trie_catalog.artefacts(table, trie_key) + [record]
        if record.scope = :trie
           and existing.any(r => r.scope = :part_group)
           and group_has_obsolete_member(table, trie_key)
           and trie_catalog.is_live(table, trie_key):
            trie_catalog.artefacts(table, trie_key) = trie_catalog.artefacts(table, trie_key).filter(r => not (r.kind = record.kind and r.definition_id = record.definition_id and r.definition_version = record.definition_version)) + [record]
        if trie_catalog.is_live(table, trie_key)
           and ((record.scope = :pack and existing.any(r => r.scope = :trie))
                or (record.scope = :trie and existing.any(r => r.scope = :pack and pack_has_obsolete_member(table, r)))):
            trie_catalog.artefacts(table, trie_key) = trie_catalog.artefacts(table, trie_key).filter(r => not (r.kind = record.kind and r.definition_id = record.definition_id and r.definition_version = record.definition_version)) + [record]
}

rule RemoveArtefact {
    -- Releasing an abandoned logical search allocation records its first settlement position and retains its exact run receipt.
    -- A later ordered prune removes the tombstone whose run receipt and settlement position match the request.
    -- The per-table checkpoint preserves the settlement position together with the tombstone until that prune applies.
    -- Removes an artefact's record from its trie's entry, on applying an artefacts-removed record (db.allium: LeaderAppliesOwnArtefactsRemoved, HandleReplicaMessage).
    -- A record matches on kind, definition id and definition version; with none matching, or no such trie, nothing changes.
    when: RemoveArtefact(table, trie_key, record)

    ensures:
        trie_catalog.artefacts(table, trie_key) = trie_catalog.artefacts(table, trie_key).filter(r => not (r.kind = record.kind and r.definition_id = record.definition_id and r.definition_version = record.definition_version))
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor ScanOperator {
    -- Internal query-engine component; declared minimally for the surface below.
    identified_by: TrieCatalog where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ScanOperatorAccess {
    -- The scan operator reads the trie catalog to determine which files to read for a query.
    -- Only live tries are used; nascent tries are excluded from query execution.
    -- See: operator/scan.clj (current-tries)

    facing scan: ScanOperator

    context table: TableRef

    exposes:
        trie_catalog.currentTries(table)    -- live tries only; see operator/scan.clj
}

