{
 "about": "Every corpus Var that does not count as a conformance failure although it failed. An entry applies only when every failure the corpus recorded for its Var satisfies its decision's match; any other failure counts. Each decision names the RTDB feature or decision that justifies it. Seeded from the corpus-full9 run (fork tests, first failure only); re-review every entry the summary reports as uncovered or stale after a run against the upstream test sources.",
 "decisions": {
  "native-database-is-not-a-jvm-node": {
   "outcome": "jvm-api-boundary",
   "decision": "RTDB's JVM binding exposes a node as xtdb.rust.NativeDatabase, reached through ADBC, pgwire and Flight SQL (bindings/jvm/README.adoc). It is not an xtdb.api.Xtdb, an xtdb.NodeBase or an xtdb.api.Xtdb$Connection, does not carry the JVM node's database catalog, does not implement the xtdb.db / xtdb.node protocols and is not a Clojure map.",
   "match": [
    "cannot be cast to class xtdb\\.api\\.Xtdb(?:Internal)?\\b",
    "cannot be cast to class xtdb\\.XtdbInternal\\b",
    "cannot be cast to class xtdb\\.NodeBase\\b",
    "cannot be cast to class xtdb\\.database\\.Database\\$Catalog\\b",
    "Cannot invoke \"xtdb\\.database\\.DatabaseCatalog\\.",
    "cannot be cast to class xtdb\\.api\\.Xtdb\\$Connection",
    "No implementation of method: :\\S+ of protocol: #'xtdb\\.(db|node)",
    "NativeDatabase cannot be cast to class clojure\\.lang\\.(Associative|ILookup|IPersistentMap)"
   ]
  },
  "native-node-config-is-yaml": {
   "outcome": "jvm-api-boundary",
   "decision": "A native node is opened from its YAML node configuration (xtdb.rust.NativeDatabase/open). start-node options that are not a map, or that hold JVM objects with no YAML spelling, have no native form.",
   "match": [
    "Unsupported native start-node options",
    "No serializer found for class"
   ]
  },
  "sql-logic-runs-through-run-sql-logic": {
   "outcome": "jvm-api-boundary",
   "decision": "The SQL logic test runner's XTDB engine plans through the JVM node's database catalog; RTDB runs the SQL logic corpus through rust/conformance/run_sql_logic.py and rust/conformance/run_sql_logic_native.py (rust/conformance/sql-logic.adoc) instead.",
   "match": [
    "plans through the JVM database catalog"
   ]
  },
  "test-defined-jvm-logical-operator": {
   "outcome": "jvm-api-boundary",
   "decision": "The test plans a logical operator it implements itself on the JVM (a namespaced operator keyword); the native planner only carries XTDB's own operators.",
   "match": [
    "plans a logical operator it defines on the JVM"
   ]
  },
  "test-defined-jvm-object-store": {
   "outcome": "jvm-api-boundary",
   "decision": "The test configures the '!InMemory' object store that its own namespace implements as a JVM class; the native engine's object stores are the configured production ones.",
   "match": [
    "Unknown object store configuration tag '!InMemory'"
   ]
  },
  "jvm-node-system-map": {
   "outcome": "jvm-api-boundary",
   "decision": "The test reads the JVM node's integrant system map, for its server port or its pgwire server's state atom and connection futures; a NativeDatabase exposes its ports through getServerPort / getFlightSqlPort and keeps its server state native.",
   "match": [
    "jdbc:(postgresql|xtdb)://localhost:/",
    "Cannot invoke \"clojure\\.lang\\.IAtom\\.swap\\(.*because \"atom\" is null",
    "Cannot invoke \"java\\.util\\.concurrent\\.Future\\.get\\(\\)\" because \"fut\" is null"
   ]
  },
  "cloud-environment-unavailable": {
   "outcome": "environment-unavailable",
   "decision": "Not an RTDB decision: the test needs a cloud CLI, cloud credentials, a real cloud endpoint or a Docker build context that the corpus environment does not provide. Re-run it where they are available.",
   "match": [
    "Cannot run program \"(az|gcloud)\"",
    "working dir should be core2 root \\(with Dockerfile\\)",
    "Unable to load credentials from any of the providers",
    "error occurred while loading credentials",
    "POST https://oauth\\d*\\.googleapis\\.com/token",
    "xtdb-object-store-iam-test",
    "addressed using the specified endpoint",
    "Moved Permanently \\(Service: S3"
   ]
  },
  "jvm-operator-spills": {
   "outcome": "jvm-internal",
   "decision": "The test counts the spill files the JVM operators write by redefining the JVM's temporary-directory function; RTDB's operators spill natively and never call it.",
   "match": [
    "\\(clojure\\.core/deref !spills\\)"
   ]
  },
  "redefines-jvm-pgwire-implementation": {
   "outcome": "jvm-internal",
   "decision": "The test's assertions hold only through a with-redefs of a var in the JVM pgwire implementation (xtdb.pgwire); RTDB's pgwire server is native and never reads that var.",
   "check": "any-failure"
  },
  "jvm-runtime-metrics": {
   "outcome": "jvm-internal",
   "decision": "RTDB has no JVM heap and no Arrow Java child-allocator tree, so it does not publish jvm.memory.used or xtdb.allocator.memory.allocated; every other metric the test asserts must still be present.",
   "check": "missing-only-jvm-runtime-metrics"
  },
  "native-data-file-layout": {
   "outcome": "jvm-layout",
   "decision": "RTDB's writer does not reproduce the reference's union-vector leg layout under null structs, so a data file's byte size can differ while every cell reads back the same; the block-catalog maps must agree in everything else.",
   "check": "block-catalog-differs-only-in-data-file-size"
  }
 },
