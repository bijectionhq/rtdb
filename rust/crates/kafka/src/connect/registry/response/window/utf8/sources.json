  "demand": {
    "packing": "quotes/control/escapes validated while raw high bytes remain undecoded; hold a full current quad until the next demanded byte or final quote",
    "quad_growth": "prior array byte length validated before native replacement allocation; initial16 entries and doubled replacements",
    "lookup": "actual complete padded-quads lookup before missed-name length/UTF8 decoding",
    "miss": "name-byte length then retained-quad decoding then admitted SymbolName then ByteChild.add/intern",
    "close": "InputStream close then symbols release in ordinary finally then recyclable input backing; quad scratch survives until cursor drop"
  },
  "profile_differences": {
    "escaped_pairs": "216 encodes each UTF16 escape separately;221 requires a valid escaped pair and emits four-byte quads",
    "raw_three_byte_surrogate": "accepted on216 miss;rejected on221 miss;an existing actual table hit precedes either miss decoder",
    "four_byte_high_unit": "addition in the name decoder, preserving inspected overlong/out-of-range source output"
  },
  "scope": "Existing actual read authority and supplied factory/global interner; no successful-name tape, source segmentation, seed or packaged classloader fabricated; current common collected-response route remains separate"
}
