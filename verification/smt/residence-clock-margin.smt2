(set-logic QF_NRA)
(declare-const rateDrift Real)
(declare-const timeout Real)
(declare-const margin Real)
(declare-const ioBound Real)
(declare-const renewalStart Real)
(declare-const firstObservation Real)
(declare-const requestStart Real)
(declare-const expiry Real)
(declare-const requestElapsed Real)
(declare-const sweepElapsed Real)

(assert (and (<= 0 rateDrift) (< rateDrift 1)))
(assert (and (< 0 timeout) (<= 0 margin) (< margin timeout) (<= 0 ioBound)))
(assert (and (<= renewalStart firstObservation) (<= renewalStart requestStart) (<= firstObservation expiry)))
(assert (>= requestElapsed (* (- 1 rateDrift) (- requestStart renewalStart))))
(assert (<= sweepElapsed (* (+ 1 rateDrift) (- expiry firstObservation))))
(assert (< requestElapsed (- timeout margin)))
(assert (<= timeout sweepElapsed))

; The collector must wait until every admitted operation has finished using the bytes.
(push)
(assert (>= margin (+ (* 2 rateDrift timeout) ioBound)))
(assert (< expiry (+ requestStart ioBound)))
(check-sat)
(pop)

; A conservative margin covers both the clock rates and the provider's use of the bytes.
(push)
(assert (>= margin ioBound))
(assert (< expiry (+ requestStart ioBound)))
(check-sat)
(pop)

(push)
(assert (>= margin (* 2 rateDrift timeout)))
(assert (< expiry (+ requestStart ioBound)))
(check-sat)
(pop)
