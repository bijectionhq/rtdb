{
  "summary": "Checkpoint metadata is collectible only below the published block and every active metadata hold.",
  "flags": ["--no-external-by-default", "--verify-module", "production", "--verify-module", "laws"],
  "min_verified_functions": 17,
  "controls": {
    "ignore_active_holds": {
      "mutate": [{
        "file": "rust/crates/multi/src/checkpoint_retention.rs",
        "find": "Some(oldest) => block < published && block < oldest,",
        "replace": "Some(_) => block < published,"
      }],
      "expect": [{
        "file": "rust/crates/multi/src/checkpoint_retention.rs",
        "function": "checkpoint_metadata_collectable",
        "category": "postcondition not satisfied"
      }],
      "min_verified_functions": 16
    },
    "ignore_active_holds_and_weaken_contract": {
      "mutate": [{
        "file": "rust/crates/multi/src/checkpoint_retention.rs",
        "find": "Some(oldest) => block < published && block < oldest,",
        "replace": "Some(_) => block < published,"
      }, {
        "file": "rust/crates/multi/src/checkpoint_retention.rs",
        "find": "\n            && (oldest.is_none() || block < oldest.unwrap()),",
        "replace": ","
      }],
      "expect": [{
        "file": "verification/verus/checkpoint_metadata/laws.rs",
        "function": "held_checkpoint_metadata_is_never_collectable",
        "category": "assertion failed"
      }, {
        "file": "rust/crates/multi/src/checkpoint_retention.rs",
        "function": "checkpoint_pack_collectable",
        "category": "postcondition not satisfied"
      }],
      "min_verified_functions": 15
    },
    "ignore_retirement_authority": {
      "defect": "Admit a past checkpoint even though no hold closed off its retirement.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "Some(first) => first <= block,\n        None => false,",
          "replace": "Some(first) => first <= block,\n        None => true,"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "function": "checkpoint_metadata_admissible",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 16
    },
    "ignore_retirement_authority_and_weaken_contract": {
      "defect": "Admit a past checkpoint even though no hold closed off its retirement.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "Some(first) => first <= block,\n        None => false,",
          "replace": "Some(first) => first <= block,\n        None => true,"
        },
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": " || (oldest.is_some() && oldest.unwrap() <= block)",
          "replace": " || (oldest.is_none() || oldest.unwrap() <= block)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/checkpoint_metadata/laws.rs",
          "function": "an_unheld_older_checkpoint_is_refused",
          "category": "assertion failed"
        },
        {
          "file": "verification/verus/checkpoint_metadata/laws.rs",
          "function": "a_retirable_pack_cannot_be_newly_admitted_as_a_historical_checkpoint",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 15
    },
    "refuse_predecessor_handoff": {
      "defect": "Refuse to share a past checkpoint already protected by a live source hold.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "Some(first) => first <= block,\n        None => false,",
          "replace": "Some(_) => false,\n        None => false,"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "function": "checkpoint_metadata_admissible",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 16
    },
    "refuse_predecessor_handoff_and_weaken_contract": {
      "defect": "Refuse to share a past checkpoint already protected by a live source hold.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "Some(first) => first <= block,\n        None => false,",
          "replace": "Some(_) => false,\n        None => false,"
        },
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": " || (oldest.is_some() && oldest.unwrap() <= block)",
          "replace": ""
        }
      ],
      "expect": [
        {
          "file": "verification/verus/checkpoint_metadata/laws.rs",
          "function": "a_protected_older_checkpoint_can_be_admitted",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 16
    },
    "ignore_pack_member_bound": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "checkpoint_metadata_collectable(pack, published, oldest)\n        && checkpoint_metadata_collectable(youngest, published, oldest)",
          "replace": "checkpoint_metadata_collectable(pack, published, oldest)"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "function": "checkpoint_pack_collectable",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 16
    },
    "ignore_pack_member_bound_and_weaken_contract": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "checkpoint_metadata_collectable(pack, published, oldest)\n        && checkpoint_metadata_collectable(youngest, published, oldest)",
          "replace": "checkpoint_metadata_collectable(pack, published, oldest)"
        },
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": " && youngest < published.unwrap()\n        && (oldest.is_none() || (pack < oldest.unwrap() && youngest < oldest.unwrap())),",
          "replace": "\n        && (oldest.is_none() || pack < oldest.unwrap()),"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/checkpoint_metadata/laws.rs",
          "function": "collection_respects_the_bound_for_every_pack_member",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 16
    },
    "retire_at_the_last_certified_boundary": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "        && boundary < anchor_through && anchor_through < published_boundary\n}",
          "replace": "        && boundary <= anchor_through && anchor_through < published_boundary\n}"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "function": "replay_archive_covers_pack",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 16
    },
    "retire_at_the_last_certified_boundary_and_weaken_contract": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "        && boundary < anchor_through && anchor_through < published_boundary\n}",
          "replace": "        && boundary <= anchor_through && anchor_through < published_boundary\n}"
        },
        {
          "file": "rust/crates/multi/src/checkpoint_retention.rs",
          "find": "        && boundary < anchor_through && anchor_through < published_boundary,",
          "replace": "        && boundary <= anchor_through && anchor_through < published_boundary,"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/checkpoint_metadata/laws.rs",
          "function": "a_replay_archive_never_retires_the_servable_boundary_or_the_published_pack",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 16
    }
  }
}
