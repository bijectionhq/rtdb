        {
          "file": "rust/crates/multi/src/journal/hosted/erasure/decision.rs",
          "find": "        && populated@[1 - selected as int]\n",
          "replace": ""
        }
      ],
      "expect": [
        {
          "file": "verification/verus/erasure_commit/laws.rs",
          "function": "rotation_evidence_requires_both_slots",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 31
    },
    "short_quorum": {
      "defect": "A rotation can use half the cohort rounded down.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/journal/hosted/erasure/decision.rs",
          "find": "    cohort >= 3 && cohort % 2 == 1 && evidence == cohort / 2 + 1\n",
          "replace": "    cohort >= 3 && cohort % 2 == 1 && evidence == cohort / 2\n"
        },
        {
          "file": "rust/crates/multi/src/journal/hosted/erasure/decision.rs",
          "find": "ensures out == (cohort >= 3 && cohort % 2 == 1 && evidence == cohort / 2 + 1),",
          "replace": "ensures out == (cohort >= 3 && cohort % 2 == 1 && evidence == cohort / 2),"
