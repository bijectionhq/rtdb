      "defect": "Frame sizing computes an off-by-one byte span for a nonempty journal body.",
      "mutate": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "find": "    let end = 8 + length as u64;",
          "replace": "    let end = 8 + (if length > 0 { length - 1 } else { 0 }) as u64;"
