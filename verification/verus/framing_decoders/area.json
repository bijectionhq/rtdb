{
  "summary": "Replica and source envelope decoding, protobuf wire limits, exact journal framing and Flight audience seat decoding.",
  "flags": [
    "--no-external-by-default"
  ],
  "foreign_contracts": [
    "prost-log-message",
    "prost-journal-record"
  ],
  "min_verified_functions": 60,
  "controls": {
    "ignore-delimited-length": {
      "defect": "A short length-delimited field is clipped to the available bytes.",
      "mutate": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "    if body > available || length > (available - body) as u64 { return None; }",
          "replace": "    if body > available { return None; }\n    if length > (available - body) as u64 { return Some(available); }"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "function": "field_end",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
    "stop-after-external-field": {
      "defect": "A recognized external payload hides a malformed suffix.",
      "mutate": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "        if field == 8 && wire == 2 { found = true; }",
          "replace": "        if field == 8 && wire == 2 { return Ok((true, cursor)); }"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "function": "scan_external_payload",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
    "drop-group-depth-check": {
      "defect": "Nested groups can recurse past the protobuf depth ceiling.",
      "mutate": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "if depth >= 100 {",
          "replace": "if depth == usize::MAX {"
        },
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "invariant start <= cursor, depth < 100, wire == 3,",
          "replace": "invariant start <= cursor, depth < usize::MAX, wire == 3,"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "function": "skip_wire",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
    "no-progress-in-group": {
      "defect": "Group traversal processes the same nested field without advancing.",
      "mutate": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "                cursor = skip_wire(bytes, nested_field, nested_wire, next, depth + 1)?;",
          "replace": "                let _ = skip_wire(bytes, nested_field, nested_wire, next, depth + 1)?;"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "function": "skip_wire",
          "category": "decreases not satisfied at end of loop"
        }
      ],
      "min_verified_functions": 59
    },
    "discard-high-key-bits": {
      "defect": "A key beyond the maximum field number can alias an in-range field.",
      "mutate": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "find": "    let field = key / 8;",
          "replace": "    let field = (key as u32) as u64 / 8;"
        }
