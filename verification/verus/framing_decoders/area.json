      "expect": [
        {
          "file": "rust/crates/format/src/envelope/wire.rs",
          "function": "wire_key",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
    "ignore-located-trailing-bytes": {
      "defect": "A single-record payload location can contain a suffix outside its declared body.",
      "mutate": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "find": "    if !matches_body(body_len(&body), length as usize, checksum(&body), expected_checksum) { return None; }",
          "replace": "    if !matches_body(body_len(&body), length as usize, checksum(&body), expected_checksum) && body_len(&body) <= length as usize { return None; }"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "function": "decode_located_record",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
    "decode-torn-stream-body": {
      "defect": "A journal reader shortens the declared length and tries to decode the shorter body.",
      "mutate": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "find": "    let Some(end) = frame_size(remaining, length) else { return Ok(None); };",
          "replace": "    let length = if length > 0 { length - 1 } else { 0 };\n    let Some(end) = frame_size(remaining, length) else { return Ok(None); };"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
