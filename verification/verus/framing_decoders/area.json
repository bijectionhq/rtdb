      "mutate": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "find": "    available == declared && actual_checksum == expected_checksum",
          "replace": "    available == declared"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/logkeeper/src/server/journal/framing.rs",
          "function": "matches_body",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 59
    },
