{
  "summary": "The shipped prepared Proposal switch preserves the original staged writes and disposition and requires the original clock slot and witness scope, complete predecessor and physical catalog, assigned source transaction and assigned system time.",
  "flags": ["--no-external-by-default"],
  "min_verified_functions": 2,
  "controls": {
    "substitute-predecessor": {
      "defect": "A prepared generation can switch after another source transaction advances its predecessor.",
      "mutate": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "    prepared.predecessor_id == installed.predecessor_id\n        && prepared.predecessor_time", "replace": "    prepared.predecessor_time"}],
      "expect": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "function": "generation_matches", "category": "postcondition not satisfied"}],
      "min_verified_functions": 1
    },
    "substitute-replica-epoch": {
      "defect": "A prepared generation can cross an unrelated replica epoch with numerically equal coordinates.",
      "mutate": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "        && prepared.replica_epoch == installed.replica_epoch\n", "replace": ""}],
      "expect": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "function": "generation_matches", "category": "postcondition not satisfied"}],
      "min_verified_functions": 1
    },
    "substitute-assigned-position": {
      "defect": "A prepared generation can switch with an assigned source position different from the source position that owns its effects.",
      "mutate": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "        && prepared_key.0 == assigned_key.0\n", "replace": ""}],
      "expect": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "function": "generation_matches", "category": "postcondition not satisfied"}],
      "min_verified_functions": 1
    },
    "substitute-installed-witness-scope": {
      "defect": "A prepared generation can publish after the installed witness scope changes.",
      "mutate": [
        {"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "            && receiver == Some(prepared_scope)\n", "replace": ""},
        {"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "\n        && matches!(receiver, Some(scope) if Scope::eq(&scope, &prepared_scope))", "replace": ""}
      ],
      "expect": [{"file": "verification/verus/prepared_landing_basis/laws.rs", "function": "select_original_staged_landing", "category": "postcondition not satisfied"}],
      "min_verified_functions": 1
    },
    "substitute-assigned-time": {
      "defect": "A prepared generation can switch with a different history timestamp at the same source transaction.",
      "mutate": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "find": "        && prepared_key.1 == assigned_key.1\n", "replace": ""}],
      "expect": [{"file": "rust/crates/tx/src/resolver/prepared_landing_basis.rs", "function": "generation_matches", "category": "postcondition not satisfied"}],
      "min_verified_functions": 1
    }
  }
}
