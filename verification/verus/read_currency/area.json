{
  "summary": "Only installed replica tips confirm catalog currency, and a confirmed clock anchor never moves backward.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "min_verified_functions": 6,
  "controls": {
    "replace_equal_tip": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "if tip <= previous",
          "replace": "if tip < previous"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "function": "observe",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 5
    },
    "replace_equal_tip_and_contract": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "if tip <= previous",
          "replace": "if tip < previous"
        },
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "pending.unwrap().1 < tip",
          "replace": "pending.unwrap().1 <= tip"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/read_currency/laws.rs",
          "function": "an_older_or_equal_tip_keeps_its_predecessor",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 5
    },
    "confirm_before_installation": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "    if installed < tip {\n        return (anchor, pending);\n    }\n",
          "replace": ""
        }
      ],
      "expect": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "function": "confirm",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 5
    },
    "confirm_before_installation_and_contract": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "    if installed < tip {\n        return (anchor, pending);\n    }\n",
          "replace": ""
        },
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": " && pending.unwrap().1 <= installed.unwrap()",
          "replace": ""
        }
      ],
      "expect": [
        {
          "file": "verification/verus/read_currency/laws.rs",
          "function": "an_uninstalled_tip_cannot_change_the_anchor",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 5
    },
    "rewind_anchor": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "    let observed_at = match anchor {\n        Some(previous) if observed_at < previous => previous,\n        _ => observed_at,\n    };\n",
          "replace": ""
        }
      ],
      "expect": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "function": "confirm",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 5
    },
    "rewind_anchor_and_contract": {
      "mutate": [
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "    let observed_at = match anchor {\n        Some(previous) if observed_at < previous => previous,\n        _ => observed_at,\n    };\n",
          "replace": ""
        },
        {
          "file": "rust/crates/node/src/read_currency/step.rs",
          "find": "if anchor.is_some() && observed < anchor.unwrap() { anchor.unwrap() } else { observed }",
          "replace": "observed"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/read_currency/laws.rs",
          "function": "a_delayed_observation_cannot_rewind_the_anchor",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 5
    }
  }
}
