        {
          "file": "verification/verus/replay_closure/production.rs",
          "function": "record_dependency_keys",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 37
    },
    "omit-search-runs": {
      "defect": "Replay omits all active search runs.",
      "mutate": [
        {
          "file": "rust/crates/format/src/catalog/checkpoint_files.rs",
          "find": "        if matches!($contents, CheckpointContents::Replay) {",
          "replace": "        if false && matches!($contents, CheckpointContents::Replay) {"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/replay_closure/production.rs",
          "function": "checkpoint_trie_files",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 37
    },
    "omit-added-artefacts": {
      "defect": "ArtefactsAdded omits valid references.",
      "mutate": [
        {
          "file": "rust/crates/replication/src/replay_closure_algorithm.rs",
          "find": "            ReplicaBody::ArtefactsAdded(message) => {\n                if same_storage(",
          "replace": "            ReplicaBody::ArtefactsAdded(message) => {\n                if false && same_storage("
        }
      ],
      "expect": [
        {
          "file": "verification/verus/replay_closure/production.rs",
          "function": "record_dependency_keys",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 37
    }
  }
}
