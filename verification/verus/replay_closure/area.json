{
  "summary": "Exact checkpoint and suffix key membership against the typed Lean replay closure.",
  "flags": [
    "--edition",
    "2024",
    "--triggers-mode",
    "silent",
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "foreign_contracts": [
    "prost-replay-payload"
  ],
  "min_verified_functions": 38,
  "controls": {
    "omit-adopted-catalog": {
      "defect": "The adopted catalog contributes no keys.",
      "mutate": [
        {
          "file": "rust/crates/replication/src/replay_closure_algorithm.rs",
          "find": "        $keys.append(&mut checkpoint_dependencies($catalog, $tables)?);",
          "replace": "        let _ = checkpoint_dependencies($catalog, $tables)?;"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/replay_closure/production.rs",
          "function": "adopt_catalog",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 37
    },
    "omit-decoded-oversized-body": {
      "defect": "The oversized proxy contributes its payload path but discards the decoded body.",
      "mutate": [
        {
          "file": "rust/crates/replication/src/replay_closure_algorithm.rs",
          "find": "                $bodies.push(Cow::Owned($envelope.unwrap_payload(&payload)?.message));",
          "replace": "                let _ = $envelope.unwrap_payload(&payload)?;"
        }
      ],
