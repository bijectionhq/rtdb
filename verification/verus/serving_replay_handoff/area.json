{
  "summary": "Serving replay source selection requires an exact parked checkpoint, unchanged selection, a strictly advancing replacement of an existing selection, and retention of pending restore inputs.",
  "flags": ["--no-external-by-default", "--verify-module", "handoff", "--verify-root"],
  "min_verified_functions": 10,
  "controls": {
    "promote_after_replay_selection": {
      "mutate": [{
        "file": "rust/crates/multi/src/archive/replay_handoff.rs",
        "find": "    !selected_replay && completed_repair_matches\n",
        "replace": "    completed_repair_matches\n"
      }],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "promotes_completed_repair", "category": "postcondition not satisfied"}],
      "min_verified_functions": 9
    },
    "promote_repair_from_another_cut": {
      "mutate": [{
        "file": "rust/crates/multi/src/archive/replay_handoff.rs",
        "find": "    !selected_replay && completed_repair_matches\n",
        "replace": "    !selected_replay\n"
      }],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "promotes_completed_repair", "category": "postcondition not satisfied"}],
      "min_verified_functions": 9
    },
    "switch_on_a_running_holder": {
      "defect": "A writer that opened the earlier physical source is still admitted during selection.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "    parked && exact_checkpoint && same_selection && match prior",
          "replace": "    exact_checkpoint && same_selection && match prior"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "may_install", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    },
    "skip_exact_checkpoint": {
      "defect": "Previously verified inventory can select another current checkpoint.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "    parked && exact_checkpoint && same_selection && match prior",
          "replace": "    parked && same_selection && match prior"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "may_install", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    },
    "switch_after_competing_install": {
      "defect": "A stale administration task can change the selection made after it started.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "    parked && exact_checkpoint && same_selection && match prior",
          "replace": "    parked && exact_checkpoint && match prior"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "may_install", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    },
    "same_block_replaces_archive": {
      "defect": "Two different captures at the same checkpoint can repeatedly replace each other.",
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "Some(prior) => prior < candidate",
          "replace": "Some(prior) => prior <= candidate"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "may_install", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    },
    "release_pending_restore": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "pending || selected.is_none()",
          "replace": "selected.is_none()"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "retains_capture", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    },
    "keep_superseded_completed_repair": {
      "mutate": [
        {
          "file": "rust/crates/multi/src/archive/replay_handoff.rs",
          "find": "pending || selected.is_none()",
          "replace": "true"
        }
      ],
      "expect": [{"file": "rust/crates/multi/src/archive/replay_handoff.rs", "function": "retains_capture", "category": "postcondition not satisfied"}],
      "min_verified_functions": 8
    }
  }
}
