        "find": "match left_iid.cmp(right_iid) {",
        "replace": "match right_iid.cmp(left_iid) {"
      }],
      "expect": [{
        "file": "rust/crates/trie/src/leaf_merge_step.rs",
        "function": "compare_row_keys",
        "category": "postcondition not satisfied"
      }, {
        "file": "rust/crates/trie/src/leaf_merge_step.rs",
        "function": "compare_row_keys",
        "category": "postcondition not satisfied"
