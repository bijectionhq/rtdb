        },
        {
          "file": "rust/crates/replication/src/retirement_receipt.rs",
          "find": "out <==> (recognized && installed >= removal && !required)",
          "replace": "out <==> (recognized && installed >= removal)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/trie_removal_receipt/laws.rs",
          "function": "a_required_trie_refuses",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 4
    },
    "exclusive_prefix": {
      "defect": "The driver incorrectly requires a later record after the removal.",
      "mutate": [
        {
          "file": "rust/crates/replication/src/retirement_receipt.rs",
          "find": "    recognized && installed >= removal && !required\n}",
          "replace": "    recognized && installed > removal && !required\n}"
        }
      ],
      "expect": [
        {
          "file": "rust/crates/replication/src/retirement_receipt.rs",
          "function": "confirms_removal",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 4
    },
